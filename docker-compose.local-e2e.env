# LangChain Service - 로컬 E2E 테스트용 환경 변수
# docker-compose.local-e2e.yml 에서 env_file로 로드

# Python 환경
PYTHONUNBUFFERED=1

# Qdrant (원격 — RAG Consumer application-local-*.yml 과 동일 NodePort)
QDRANT_URL=http://192.168.0.116:30633
QDRANT_COLLECTION=rag_chunks
QDRANT_API_KEY=

# Redis (선택사항, 세션 히스토리용)
REDIS_URL=redis://:init123!@192.168.0.100:6379/0

# Control Plane Gateway (컨테이너 → 호스트 PC의 gateway-backend :9002)
# LangChain 임베딩·채팅 API 호출 시 Gateway 경유
GATEWAY_URL=http://host.docker.internal:9002

# QA/RAG 임베딩·채팅 모두 요청 X-API-Key(UAK) 사용 — aiGateway에 등록된 유효한 키 필요

# OpenAI API (레거시/로컬 도구용, QA 스트림 경로에서는 미사용)
# OPENAI_API_KEY=sk-your-key-here

# RAG 설정
RAG_TOP_K=4
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_REQUIRE_QDRANT=0
STREAM_TIMEOUT_SECONDS=120
RAG_PERSONAL_CATEGORY_ID=61911ccb-8733-4b2b-9476-25d2347605a9
