# 로컬 실행용 환경변수 템플릿.
# 이 파일을 복사해 .env 를 만들고 실제 값을 채우세요. .env는 .gitignore에 등록되어 커밋되지 않습니다.
#   cp .env.example .env

# --- Database (필수) ---
RAG_LOCAL_DATASOURCE_URL=jdbc:postgresql://localhost:30543/rag
RAG_LOCAL_DATASOURCE_USERNAME=
RAG_LOCAL_DATASOURCE_PASSWORD=

# --- MinIO (필수) ---
MINIO_END_POINT=
MINIO_PUBLIC_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# --- Qdrant (필수) ---
RAG_QDRANT_BASE_URL=
RAG_QDRANT_COLLECTION=

# --- Redis (local-consumer, 기본값 있음: localhost:6379) ---
#REDIS_HOST=localhost
#REDIS_PORT=6379
#REDIS_PASSWORD=

# --- Gateway / LangChain (기본값 있음: http://localhost:9002, http://localhost:8000) ---
#GATEWAY_URL=http://localhost:9002
#RAG_LANGCHAIN_BASE_URL=http://localhost:8000
#RAG_PCC_LANGCHAIN_BASE_URL=http://localhost:8000
