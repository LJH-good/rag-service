# 로컬 실행용 환경변수 템플릿.
# 이 파일을 복사해 .env 를 만들고 실제 값을 채우세요. .env는 .gitignore에 등록되어 커밋되지 않습니다.
#   cp .env.example .env

# --- Database (필수) ---
# docker-compose.local-infra.yml 로 로컬에 띄운 rag-postgres-local 기준 기본값.
# 원격 공유 인스턴스를 쓰려면 URL/계정을 해당 값으로 바꿀 것.
RAG_LOCAL_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rag
RAG_LOCAL_DATASOURCE_USERNAME=rag_user
RAG_LOCAL_DATASOURCE_PASSWORD=rag_password

# --- MinIO (필수) ---
# docker-compose.local-infra.yml 로 로컬에 띄운 rag-minio-local 기준 기본값.
MINIO_END_POINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=rag

# --- Qdrant (필수) ---
# docker-compose.local-infra.yml 로 로컬에 띄운 rag-qdrant-local 기준 기본값.
RAG_QDRANT_BASE_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=rag_chunks

# --- Redis (local-consumer, 기본값 있음: localhost:6379) ---
#REDIS_HOST=localhost
#REDIS_PORT=6379
#REDIS_PASSWORD=

# --- Gateway / LangChain (기본값 있음: http://localhost:9002, http://localhost:8000) ---
#GATEWAY_URL=http://localhost:9002
#RAG_LANGCHAIN_BASE_URL=http://localhost:8000
#RAG_PCC_LANGCHAIN_BASE_URL=http://localhost:8000
